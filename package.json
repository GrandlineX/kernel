{
  "name": "@grandlinex/kernel",
  "version": "3.0.0-alpha.9",
  "description": "GrandLineX is an out-of-the-box server framework on top of ExpressJs.",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "run": "tsx tests/run.ts",
    "run-swagger": "tsx tests/SwaggerTest.ts",
    "pack-dev": "npm version -no-git-tag-version prerelease && npm run build && npm pack",
    "test-coverage": "vitest run --coverage",
    "makeDocs": "typedoc",
    "makeSpec": "swagger-mate"
  },
  "keywords": [
    "typescript",
    "framework",
    "express",
    "orm",
    "server",
    "backend"
  ],
  "author": {
    "name": "Elschnagoo"
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "@grandlinex/core": "3.0.0-alpha.9",
    "@grandlinex/swagger-mate": "3.0.0-alpha.9",
    "@types/jsonwebtoken": "9.0.10",
    "@types/ms": "2.1.0",
    "body-parser": "2.2.1",
    "jsonwebtoken": "9.0.2",
    "reflect-metadata": "0.2.2"
  },
  "peerDependencies": {
    "@types/express": ">=5.0.6",
    "axios": ">=1.19.0",
    "express": ">=5.2.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.9.0",
    "eslint-plugin-prettier": "5.2.1",
    "prettier": "3.5.3",
    "tsx": "4.23.12",
    "typedoc": "0.28.20",
    "tsdown": "0.22.14",
    "vitest": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GrandlineX/kernel.git"
  }
}
